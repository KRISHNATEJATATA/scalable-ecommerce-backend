# Example environment. Copy to .env for local dev. NO real secrets in this file.

# --- App ---
APP_NAME=scalable-ecommerce-backend
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Database (REQUIRED - app fails fast if unset) ---
DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@localhost:5432/ecommerce
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- Valkey (rate-limit counters, idempotency keys, JWT jti denylist) ---
VALKEY_URL=redis://localhost:6379/0

# --- Auth / JWT (RS256, Phase 5) ---
# Point these at PEM keys; never commit real keys.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Cookies / security ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# JSON array; explicit allow-list, never ["*"] past dev.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- S3 / uploads (Phase 7; MinIO locally) ---
S3_BUCKET=ecommerce-uploads
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000

# --- SQS async worker (Phase 8; ElasticMQ locally) ---
SQS_QUEUE_URL=http://localhost:9324/queue/emails
SQS_ENDPOINT_URL=http://localhost:9324
