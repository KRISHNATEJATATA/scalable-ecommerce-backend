# Example environment. Copy to .env for local dev. NO real secrets in this file.

# --- App ---
APP_NAME=scalable-ecommerce-backend
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Database (REQUIRED - app fails fast if unset) ---
DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@localhost:5432/ecommerce
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- Valkey (rate-limit counters, idempotency keys) ---
VALKEY_URL=redis://localhost:6379/0

# --- Auth: OIDC via Keycloak (app is a resource server, Phase 5) ---
# The app only VALIDATES Keycloak-issued RS256 tokens (JWKS) and calls the
# Admin API for user/role management. Keycloak owns login/refresh/passwords.
KEYCLOAK_ISSUER=http://localhost:8080/realms/ecommerce
KEYCLOAK_REALM=ecommerce
KEYCLOAK_AUDIENCE=ecommerce-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/ecommerce/protocol/openid-connect/certs
# Admin service-account (for admin endpoints that manage users/roles).
KEYCLOAK_ADMIN_CLIENT_ID=ecommerce-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-local-only
# Access-token TTL is configured in Keycloak (~5 min); revocation relies on it.

# --- CORS (bearer-token auth: no cookies, allow_credentials stays false) ---
# JSON array; explicit allow-list (the SPA origin), never ["*"] past dev.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- S3 / uploads (Phase 7-8; LocalStack S3 locally) ---
S3_BUCKET=ecommerce-uploads
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566
# Public CDN base for serving product images UNSIGNED (CloudFront in prod).
# Leave unset locally to fall back to f"{S3_ENDPOINT_URL}/{S3_BUCKET}".
S3_PUBLIC_BASE_URL=http://localhost:4566/ecommerce-uploads

# --- Secure image uploads + image worker (Phase 8) ---
IMAGE_MAX_UPLOAD_BYTES=5242880
IMAGE_MAX_DIMENSION=2048
IMAGE_UPLOAD_TTL_SECONDS=300
# SQS queue the ImageWorker drains (S3 ObjectCreated notifications). LocalStack locally.
IMAGE_QUEUE_URL=http://localhost:4566/000000000000/image-uploads

# --- SQS async worker (Phase 8; ElasticMQ locally) ---
SQS_QUEUE_URL=http://localhost:9324/queue/emails
SQS_ENDPOINT_URL=http://localhost:9324

# --- Event bus: transactional outbox -> SNS/SQS (LocalStack locally) ---
# Relay ships outbox rows to per-event-type SNS topics; consumers read per-subscription
# SQS queues with DLQs. Leave BUS_ENDPOINT_URL empty in the cloud (ECS task role).
BUS_ENDPOINT_URL=http://localhost:4566
BUS_REGION=us-east-1
BUS_TOPIC_PREFIX=ecommerce-
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_SECONDS=1.0
CONSUMER_MAX_MESSAGES=10
CONSUMER_WAIT_TIME_SECONDS=10
CONSUMER_DEDUP_TTL_SECONDS=86400
